{
  "name": "luizvasconceloss-hiera_ssm_paramstore",
  "version": "1.0.0",
  "author": "Luiz Vasconcelos",
  "summary": "Hiera 5 backend to query data on AWS System Manager Parameter Store",
  "license": "Apache-2.0",
  "source": "https://github.com/luizvasconceloss/hiera-ssm-paramstore",
  "project_page": "https://github.com/luizvasconceloss/hiera-ssm-paramstore",
  "issues_url": "https://github.com/luizvasconceloss/hiera-ssm-paramstore/issues",
  "dependencies": [
    {
      "name": "puppetlabs/puppetserver_gem",
      "version_requirement": ">= 1.1.0 < 2.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "7",
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "10",
        "11",
        "12"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "20.04",
        "22.04",
        "24.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ],
  "pdk-version": "3.5.1",
  "template-url": "pdk-default#3.5.1"
}
